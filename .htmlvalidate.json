{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "require-sri": "off",
    "no-inline-style": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h37": "error",
    "valid-id": [
      "error",
      {
        "relaxed": true
      }
    ]
  }
}
