// Cloudflare Workers, static assets only: no "main", so no script runs and nothing needs auditing.
// Headers and the cache policy live in public/_headers (copied to dist/ by Astro).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenithboard-site",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false
}
